# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Docs
docs/_build/

# Agent
.claude/settings.local.json

# Data: private data never leaves this machine, but its manifest does.
# SPEC 0003 created these trees and made the dataset root the checkout itself, so the
# embargoed records now live inside the repository and these rules are what keep them out
# of it. MANIFEST.toml is the deliberate exception: it inventories the records by sha256 so
# a result can be audited by someone who will never receive them.
data/real_private/*
!data/real_private/MANIFEST.toml

# Data: simulated payloads are regenerated, their manifests are not
data/simulated/*
!data/simulated/*.toml
!data/simulated/*.json

# Outputs: artifacts are too large to track; run manifests are committed by hand.
# `output/` is what the tool writes and the one name the specs use. It measures 309M here.
# The two backup names are kept listed so that restoring either from elsewhere cannot
# un-ignore it by accident; neither directory exists at present.
output/
output_backup/
output_backup2/

# OS
.DS_Store
