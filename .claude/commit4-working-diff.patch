diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 6983ea1..79988dd 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -46,3 +46,29 @@ jobs:
 
       - name: make deps
         run: make deps
+
+      # Printed, never gated: no fail_under, no diff against a previous run, no external
+      # service. It is here so a module executing code nothing checks stays visible.
+      # `continue-on-error` so a later `fail_under` in config cannot quietly make it a gate.
+      #
+      # Runs the TARGET rather than a copy of its command, for the same reason `make check`
+      # above does. `cov` depends on `require-selector`, which is what stops an empty
+      # selector file running every excluded tier, and the selector and data state come from
+      # the target's own output, so both are measured here rather than asserted by this file.
+      #
+      # `tee` yields its own exit status, not the pipeline's, so a failed run would otherwise
+      # leave an empty fenced block and no explanation. PIPESTATUS is read and reported
+      # instead of `set -o pipefail`, which under `bash -e` would abort before the fence is
+      # closed and leave the summary with an unterminated code block.
+      - name: coverage (reported, never gated)
+        continue-on-error: true
+        run: |
+          {
+            echo "### Coverage - python ${{ matrix.python-version }}"
+            echo ""
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+          make cov 2>&1 | tee -a "$GITHUB_STEP_SUMMARY"
+          rc=${PIPESTATUS[0]}
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+          [ "$rc" -eq 0 ] || echo "make cov exited $rc" >> "$GITHUB_STEP_SUMMARY"
